{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bridge",
  "version": "0.0.1",
  "identifier": "cc.worldmandia.bridge",
  "build": {
    "frontendDist": "../build/dist/wasmJs/productionExecutable",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "gradle :composeApp:wasmJsBrowserDevelopmentRun -q",
    "beforeBuildCommand": "gradle :composeApp:wasmJsBrowserDistribution -q"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "bridge",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
